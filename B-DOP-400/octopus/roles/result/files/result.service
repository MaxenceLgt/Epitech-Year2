[Unit]
Description=Upload result service
After=network-online.target

[Service]
Type=simple
Environment=PORT=80
Environment=POSTGRES_HOST={{ postgresql_host }}
Environment=POSTGRES_PORT=5432
Environment=POSTGRES_DB={{ db_name }}
Environment=POSTGRES_USER={{ db_user }}
Environment=POSTGRES_PASSWORD={{ db_user_pass }}
ExecStart=node /home/{{ ansible_user }}/result/server.js
Restart:on-failure

[Install]
WantedBy=multi-user.target